# Backend environment (placeholders only — do not commit real secrets).
# Copy to backend/.env and fill in local values.

# Google OAuth Web Client ID (token audience for POST /chat auth).
GOOGLE_CLIENT_ID=

# Comma-separated browser origins allowed to call this API (CORS).
# Required for local Next.js: include http://localhost:3000
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000
# Leave empty/unset to deny all browser origins (fail closed).
CORS_ALLOWED_ORIGINS=http://localhost:3000
